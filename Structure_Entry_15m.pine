//@version=5
// Structure Entry 15m
// Runs on the 15m chart and reads the 1m candles inside each 15m candle.
// 4H direction: same swing + BOS + protected swing rules. Entries only when 4H and 15m agree.
// Swings on 4H, 15m and 1m: a high or low counts once price has moved away from it by a set size (x that timeframe's ATR), so small moves are ignored.
// 15m trend: BOS on a close beyond the last swing. The low that led to the BOS is protected; the trend only
// changes on a close beyond it, so a minor swing inside a pullback does not flip the trend.
// Pullback that holds the protected swing -> 1m LH + LL, CHoCH above the last LH, then 1m BOS (mirror for shorts).
// Entry on the next 15m candle that closes in the trend direction. Stop beyond the pullback extreme (the HL), target the prior extreme (the HH).
// Everything is decided on closed 15m candles (no repaint).
indicator("Structure Entry 15m", shorttitle = "Structure 15m", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ───────────────────────── Inputs ─────────────────────────
string GT = "Structure"
useCtx   = input.bool(true, "Only trade with the higher TF direction", group = GT)
ctxRes   = input.timeframe("240", "Higher TF", group = GT)
ctxAtrX  = input.float(3.0, "Higher TF swing size (x ATR)", minval = 0.5, step = 0.5, group = GT)
ltfRes   = input.timeframe("1", "Confirmation TF", group = GT)
swingAtr = input.float(3.0, "Chart swing size (x ATR)", minval = 0.5, step = 0.5, group = GT, tooltip = "Higher = only bigger swings count, a broader view of the trend.")
ltfAtrX  = input.float(3.0, "Confirmation TF swing size (x ATR)", minval = 0.5, step = 0.5, group = GT, tooltip = "Same rule as the chart swings, with the ATR of the confirmation TF.")
minPb    = input.float(0.30, "Min pullback (share of protected swing -> extreme)", step = 0.05, group = GT)
confirm  = input.string("BOS after CHoCH", "Confirmation", options = ["BOS after CHoCH", "CHoCH"], group = GT)

string GR = "Risk"
slBuf    = input.float(0.10, "Stop beyond pullback extreme (x ATR)", step = 0.05, group = GR)
oneEntry = input.bool(true, "One entry per pullback", group = GR, tooltip = "On: after an entry, no new entry until price makes a new extreme. Off: a new low after the entry allows another one.")
minRR    = input.float(0.0, "Min RR to the prior extreme (0 = off)", step = 0.5, group = GR)

string GD = "Display"
showProt = input.bool(true, "Show protected swing", group = GD)
showConf = input.bool(true, "Mark confirmation", group = GD)
showSwg  = input.bool(true, "Show swings (HH / HL / LH / LL)", group = GD)
showTbl  = input.bool(true, "Show info table", group = GD)
lineLen  = input.int(16, "Entry / SL / TP line length (bars)", minval = 2, group = GD)

if timeframe.in_seconds(ltfRes) >= timeframe.in_seconds(timeframe.period)
    runtime.error("Open a chart higher than the Confirmation TF, e.g. 15m chart with 1m confirmation.")
if useCtx and timeframe.in_seconds(ctxRes) <= timeframe.in_seconds(timeframe.period)
    runtime.error("Higher TF must be above the chart, e.g. 4H with a 15m chart.")

// ───────────────────────── Side tracker ─────────────────────────
// Prices are signed: a short side sees -low as its high, so both sides run the same logic.
type Side
    int   dir
    float ext    = na
    int   tExt   = 0
    float pb     = na
    float lh     = na
    int   tLh    = 0
    float refL   = na
    float lastL  = na
    int   tLastL = 0
    bool  dead   = false
    bool  fired  = false
    float sigPb  = na
    bool  choch  = false
    int   tChoch = 0
    float bos    = na
    float pend   = na
    bool  entered = false

// Forget the confirmation TF structure, keep the pullback extreme
method clearStruct(Side s) =>
    s.lh     := na
    s.tLh    := 0
    s.refL   := na
    s.lastL  := na
    s.tLastL := 0
    s.fired  := false
    s.choch  := false
    s.tChoch := 0
    s.bos    := na
    true

// Feeds one closed confirmation TF candle. Returns the signed pullback extreme when it confirms, else na.
method step(Side s, bool active, int t, float hi, float lo, float cl, float ph, float pl, int tPiv, float prot) =>
    float sig = na
    if not active
        s.ext  := na
        s.pb   := na
        s.pend := na
        s.dead := false
        s.entered := false
        s.clearStruct()
    else if na(s.ext) or hi > s.ext
        s.ext  := hi
        s.tExt := t
        s.pb   := na
        s.pend := na
        s.dead := false
        s.entered := false
        s.clearStruct()
    else
        s.pb := na(s.pb) ? lo : math.min(s.pb, lo)
        // a new low after a confirmation = that pullback was not over: look for a new confirmation
        if s.fired and lo < s.sigPb and not (oneEntry and s.entered)
            s.fired  := false
            s.choch  := false
            s.tChoch := 0
            s.bos    := na
        if not na(pl) and tPiv > s.tExt
            s.lastL  := pl
            s.tLastL := tPiv
        if not na(ph) and tPiv > s.tExt and ph < s.ext
            s.lh   := ph
            s.tLh  := tPiv
            s.refL := s.lastL
            if s.choch and tPiv > s.tChoch
                s.bos := ph
        // a wick through the protected swing is allowed: only a chart close beyond it ends the trend
        if na(prot)
            s.dead := true
        if not s.dead and not s.fired
            bool deep = (s.ext - s.pb) / (s.ext - prot) >= minPb
            bool ll   = not na(s.lh) and not na(s.lastL) and s.tLastL > s.tLh and (na(s.refL) or s.lastL < s.refL)
            if s.choch
                if not na(s.bos) and cl > s.bos
                    sig := s.pb
            else if deep and ll and cl > s.lh
                if confirm == "CHoCH"
                    sig := s.pb
                else
                    s.choch  := true
                    s.tChoch := t
            if not na(sig)
                s.fired := true
                s.sigPb := sig
    sig

// ───────────────────────── Data ─────────────────────────
// [1] + lookahead_on = values of the last CLOSED higher TF bar -> no repaint
[xH, xL, xC, xT, xAtr] = request.security(syminfo.tickerid, ctxRes, [high[1], low[1], close[1], time[1], ta.atr(14)[1]], lookahead = barmerge.lookahead_on)
int  ctxChg = ta.change(xT)
bool ctxNew = not na(xT) and not na(ctxChg) and ctxChg != 0
[lT, lH, lL, lC] = request.security_lower_tf(syminfo.tickerid, ltfRes, [time, high, low, close])
float atrNow  = ta.atr(14)
float atrPrev = atrNow[1]

var array<float> arrH = array.new_float()
var array<float> arrL = array.new_float()
var float ltfAtr   = na
var float ltfSum   = 0.0
var int   ltfCnt   = 0
var float ltfPrev  = na
var int   lzDir    = 1
var float lzExt    = na
var int   lzT      = 0
var int   trend    = 0
var float swingH   = na
var float swingL   = na
var int   swingHi  = 0
var int   swingLi  = 0
var bool  hBroken  = true
var bool  lBroken  = true
var float protL    = na
var float protH    = na
var int   protI    = 0
var Side  longS    = Side.new(1)
var Side  shortS   = Side.new(-1)
var string lastSig = "none"
var bool  ltfOk    = false
var array<float> ctxHs = array.new_float()
var array<float> ctxLs = array.new_float()
var int   ctxTrend = 0
var float ctxSwH   = na
var float ctxSwL   = na
var int   ctxSwHi  = 0
var int   ctxSwLi  = 0
var bool  ctxHBrk  = true
var bool  ctxLBrk  = true
var float ctxProtL = na
var float ctxProtH = na
var int   ctxProtI = 0
var int   czDir    = 1
var float czExt    = na
var int   czI      = 0
var int   zzDir    = 1
var float zzExt    = na
var int   zzI      = 0
var int   zzBar    = 0
var int   lastBar  = na
var float lastPx   = na

// Draws the confirmed swing and names it against the previous swing on the same side
f_swing(bool isHigh, float px, float prevSame, int bar) =>
    if showSwg
        string nm = na(prevSame) ? (isHigh ? "H" : "L") : isHigh ? (px > prevSame ? "HH" : "LH") : (px > prevSame ? "HL" : "LL")
        if not na(lastBar)
            line.new(lastBar, lastPx, bar, px, color = color.new(color.silver, 40))
        label.new(bar, px, nm, style = isHigh ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = color.silver, size = size.small)
    true

// Most extreme value of a from index i0 to the end, as [value, index]
f_extreme(array<float> a, int i0, bool wantMax) =>
    float v = a.get(i0)
    int   ix = i0
    for k = i0 to a.size() - 1
        if wantMax ? a.get(k) > v : a.get(k) < v
            v  := a.get(k)
            ix := k
    [v, ix]

f_signal(int dir, float signedPb, float signedExt) =>
    float sl   = dir * (signedPb - slBuf * atrPrev)
    float tp   = dir * signedExt
    float risk = (close - sl) * dir
    float gain = (tp - close) * dir
    string res = ""
    if risk > 0 and gain > 0 and gain >= minRR * risk
        string txt = (dir == 1 ? "LONG " : "SHORT ") + str.tostring(close, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + "\nTP " + str.tostring(tp, format.mintick)
        label.new(bar_index, dir == 1 ? low : high, txt, style = dir == 1 ? label.style_label_up : label.style_label_down, color = dir == 1 ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)
        line.new(bar_index, close, bar_index + lineLen, close, color = color.gray)
        line.new(bar_index, sl, bar_index + lineLen, sl, color = color.red)
        line.new(bar_index, tp, bar_index + lineLen, tp, color = color.green)
        alert(txt + "\n" + syminfo.ticker, alert.freq_once_per_bar_close)
        res := (dir == 1 ? "LONG " : "SHORT ") + str.tostring(close, format.mintick)
    res

// One confirmation TF candle for one side: keep or drop the waiting entry
f_pending(Side s, float sig, float signedLow) =>
    if not na(s.pend) and signedLow < s.pend
        s.pend := na
    if not na(sig)
        s.pend := sig
        if showConf
            label.new(bar_index, s.dir == 1 ? high : low, confirm + " ok", style = s.dir == 1 ? label.style_label_down : label.style_label_up, color = color.new(color.blue, 30), textcolor = color.white, size = size.tiny)
    true

// Chart candle closed: enter if it closed in the trend direction
f_entry(Side s, float signedClose, float signedOpen) =>
    string res = ""
    if not na(s.pend) and signedClose > signedOpen
        res := f_signal(s.dir, s.pend, s.ext)
        s.pend := na
        if res != ""
            s.entered := true
    res

// ───────────────────────── Main (closed chart candles only) ─────────────────────────
if barstate.isconfirmed
    // 0) higher TF direction from closed bars
    if ctxNew
        ctxHs.push(xH)
        ctxLs.push(xL)
        int ci = ctxHs.size() - 1
        if na(czExt)
            czExt := xH
            czI   := ci
        else if not na(xAtr)
            if czDir == 1
                if xH > czExt
                    czExt := xH
                    czI   := ci
                else if czExt - xL >= ctxAtrX * xAtr
                    ctxSwH  := czExt
                    ctxSwHi := czI
                    ctxHBrk := false
                    czDir   := -1
                    czExt   := xL
                    czI     := ci
            else
                if xL < czExt
                    czExt := xL
                    czI   := ci
                else if xH - czExt >= ctxAtrX * xAtr
                    ctxSwL  := czExt
                    ctxSwLi := czI
                    ctxLBrk := false
                    czDir   := 1
                    czExt   := xH
                    czI     := ci
        if not ctxHBrk and xC > ctxSwH
            ctxHBrk := true
            if ctxTrend >= 0
                [v, ix] = f_extreme(ctxLs, ctxSwHi, false)
                ctxProtL := v
                ctxProtI := ix
                ctxTrend := 1
        if not ctxLBrk and xC < ctxSwL
            ctxLBrk := true
            if ctxTrend <= 0
                [v, ix] = f_extreme(ctxHs, ctxSwLi, true)
                ctxProtH := v
                ctxProtI := ix
                ctxTrend := -1
        if ctxTrend == 1 and not na(ctxProtL) and xC < ctxProtL
            [v, ix] = f_extreme(ctxHs, ctxProtI, true)
            ctxProtH := v
            ctxProtI := ix
            ctxTrend := -1
            ctxLBrk  := true
        else if ctxTrend == -1 and not na(ctxProtH) and xC > ctxProtH
            [v, ix] = f_extreme(ctxLs, ctxProtI, false)
            ctxProtL := v
            ctxProtI := ix
            ctxTrend := 1
            ctxHBrk  := true
    bool okLong  = trend == 1 and (not useCtx or ctxTrend == 1)
    bool okShort = trend == -1 and (not useCtx or ctxTrend == -1)

    // 1) confirmation TF candles inside this chart candle, on the trend known before it closed
    int nl = lT.size()
    ltfOk := nl > 0
    if nl > 0
        for i = 0 to nl - 1
            float h1 = lH.get(i)
            float l1 = lL.get(i)
            float c1 = lC.get(i)
            int   t1 = lT.get(i)
            // ATR(14) of the confirmation TF
            float tr = na(ltfPrev) ? h1 - l1 : math.max(h1 - l1, math.abs(h1 - ltfPrev), math.abs(l1 - ltfPrev))
            ltfCnt  += 1
            ltfPrev := c1
            if ltfCnt <= 14
                ltfSum += tr
                if ltfCnt == 14
                    ltfAtr := ltfSum / 14
            else
                ltfAtr := (ltfAtr * 13 + tr) / 14
            // swings by size
            float ph = na
            float pl = na
            int tPiv = 0
            if na(lzExt)
                lzExt := h1
                lzT   := t1
            else if not na(ltfAtr)
                if lzDir == 1
                    if h1 > lzExt
                        lzExt := h1
                        lzT   := t1
                    else if lzExt - l1 >= ltfAtrX * ltfAtr
                        ph    := lzExt
                        tPiv  := lzT
                        lzDir := -1
                        lzExt := l1
                        lzT   := t1
                else
                    if l1 < lzExt
                        lzExt := l1
                        lzT   := t1
                    else if h1 - lzExt >= ltfAtrX * ltfAtr
                        pl    := lzExt
                        tPiv  := lzT
                        lzDir := 1
                        lzExt := h1
                        lzT   := t1
            float sL = longS.step(okLong, t1, h1, l1, c1, ph, pl, tPiv, protL)
            float sS = shortS.step(okShort, t1, -l1, -h1, -c1, na(pl) ? na : -pl, na(ph) ? na : -ph, tPiv, -protH)
            f_pending(longS, sL, l1)
            f_pending(shortS, sS, -h1)

    // 2) entry on this candle's close
    string rL = f_entry(longS, close, open)
    string rS = f_entry(shortS, -close, -open)
    if rL != ""
        lastSig := rL
    if rS != ""
        lastSig := rS

    // 3) chart structure, used from the next candle on
    arrH.push(high)
    arrL.push(low)
    int nowI = arrH.size() - 1
    if na(zzExt)
        zzExt := high
        zzI   := nowI
        zzBar := bar_index
    else if not na(atrNow)
        if zzDir == 1
            if high > zzExt
                zzExt := high
                zzI   := nowI
                zzBar := bar_index
            else if zzExt - low >= swingAtr * atrNow
                f_swing(true, zzExt, swingH, zzBar)
                lastBar := zzBar
                lastPx  := zzExt
                swingH  := zzExt
                swingHi := zzI
                hBroken := false
                zzDir   := -1
                zzExt   := low
                zzI     := nowI
                zzBar   := bar_index
        else
            if low < zzExt
                zzExt := low
                zzI   := nowI
                zzBar := bar_index
            else if high - zzExt >= swingAtr * atrNow
                f_swing(false, zzExt, swingL, zzBar)
                lastBar := zzBar
                lastPx  := zzExt
                swingL  := zzExt
                swingLi := zzI
                lBroken := false
                zzDir   := 1
                zzExt   := high
                zzI     := nowI
                zzBar   := bar_index
    if not hBroken and close > swingH
        hBroken := true
        if trend >= 0
            [v, ix] = f_extreme(arrL, swingHi, false)
            protL := v
            protI := ix
            trend := 1
    if not lBroken and close < swingL
        lBroken := true
        if trend <= 0
            [v, ix] = f_extreme(arrH, swingLi, true)
            protH := v
            protI := ix
            trend := -1
    if trend == 1 and not na(protL) and close < protL
        [v, ix] = f_extreme(arrH, protI, true)
        protH := v
        protI := ix
        trend := -1
        lBroken := true
    else if trend == -1 and not na(protH) and close > protH
        [v, ix] = f_extreme(arrL, protI, false)
        protL := v
        protI := ix
        trend := 1
        hBroken := true

// ───────────────────────── Drawing ─────────────────────────
plot(showProt and trend == 1 ? protL : na, "Protected low", color.new(color.lime, 20), 2, plot.style_linebr)
plot(showProt and trend == -1 ? protH : na, "Protected high", color.new(color.red, 20), 2, plot.style_linebr)

var table tbl = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 25), border_width = 1)
if barstate.islast and showTbl
    bool waiting = not na(longS.pend) or not na(shortS.pend)
    table.cell(tbl, 0, 0, "Chart trend", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 0, trend == 1 ? "UP" : trend == -1 ? "DOWN" : "n/a", text_color = trend == 1 ? color.lime : trend == -1 ? color.red : color.gray, text_size = size.small)
    table.cell(tbl, 0, 1, "Confirmation", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 1, confirm, text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 2, "Confirmation TF data", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 2, ltfOk ? "OK" : "none", text_color = ltfOk ? color.lime : color.orange, text_size = size.small)
    table.cell(tbl, 0, 3, "Waiting for entry candle", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 3, waiting ? "YES" : "no", text_color = waiting ? color.yellow : color.gray, text_size = size.small)
    table.cell(tbl, 0, 4, "Last signal", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 4, lastSig, text_color = color.yellow, text_size = size.small)
    table.cell(tbl, 0, 5, "Higher TF trend", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 5, ctxTrend == 1 ? "UP" : ctxTrend == -1 ? "DOWN" : "n/a", text_color = ctxTrend == 1 ? color.lime : ctxTrend == -1 ? color.red : color.gray, text_size = size.small)
