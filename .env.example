# LVN scalp bot - copy this file to .env and fill in your keys. Never share .env.
#
# Use a TRADE-ONLY key: Futures on, withdrawals OFF, IP whitelist ON.
# Best on a sub-account used only by this bot.
# Testnet keys: https://testnet.binancefuture.com (log in, API Key tab). Mainnet keys do not work there.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Safe defaults. Real-money orders need BOTH lines changed on purpose:
#   USE_TESTNET=false  and  TRADING_ENABLED=true
USE_TESTNET=false
TRADING_ENABLED=true

# Create this file (empty) in the bot folder to stop new entries at once.
# REST weight this bot may use per minute. The IP limit (2400) is shared with other bots on the same VPS.
OWN_WEIGHT_PER_MIN=1800

KILL_SWITCH_FILE=KILL_SWITCH

# Symbols the bot must never trade, comma separated
SYMBOL_DENYLIST=

# ------------------------------------------------------------ symbols
# Fixed list (comma separated). Empty = the UNIVERSE_SIZE highest 24h volume USDT perps with >= MIN_QUOTE_VOLUME.
SCAN_SYMBOLS=
UNIVERSE_SIZE=200
MIN_QUOTE_VOLUME=2000000

# ------------------------------------------------------------ risk
MARGIN_USDT=10           # LIVE: fixed margin per trade in USDT. Leverage = that symbol's max leverage
LIQ_BUFFER=0.25          # leverage is lowered only if liquidation would be closer than stop x 1.25
RISK_PCT=0.25            # PAPER only: % of PAPER_EQUITY lost at the stop
MARGIN_TYPE=ISOLATED
MAX_POSITIONS=3
DAILY_LOSS_LIMIT_R=3     # no new entries for the rest of the UTC day
CONSECUTIVE_LOSS_LIMIT=4
COOLDOWN_H=6
PAPER_EQUITY=1000

# ------------------------------------------------------------ strategy
REQUIRE_NESTED=false     # false = every FRESH 5m LVN (nested or not); true = nested only
SKIP_SLOW=true           # skip slow approaches (<= 2 ATR in 30 min)
NEAR_SD_ATR=1.0          # LVN and its S/D within 1 ATR -> one merged zone
SD_FALLBACK=true         # LVN failed -> watch its fresh S/D zone
CONFIRM=CHOCH            # CHOCH or BOS (1m, script reaction marks)
ABSORB_VOL_X=2.0
ABSORB_DELTA=0.20
FLIP_DELTA=0.10
LIQ_DOMINANCE=2.0
BOOK_IMB=0.20
# signal when at least this many of the 5 order flow gates pass (absorption, delta shift, CVD divergence, liquidation flush, book imbalance)
OF_MIN_PASS=2
SL_BUFFER_ATR=0.50
TP_FRONT_ATR=0.05
MIN_RR=2.0
BE_AT_R=1.5              # stop to break-even at 1.5R, 0 = off
MAX_SPREAD_BPS=6
